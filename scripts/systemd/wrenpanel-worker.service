[Unit]
Description=WrenPanel Root Worker (Privileged Allowlist Service)
After=network.target
Before=wrenpanel.service

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=wrenpanel
RuntimeDirectoryMode=0755
ExecStart=/opt/wrenpanel/bin/wrenpanel-worker --socket /run/wrenpanel/worker.sock
Restart=always
RestartSec=3s

# Logging
StandardOutput=append:/var/log/wrenpanel/worker.log
StandardError=append:/var/log/wrenpanel/worker.log

[Install]
WantedBy=multi-user.target
